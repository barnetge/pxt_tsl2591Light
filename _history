\" line31=\"    function writeRegister(reg: number, val: number): void {\" line32=\"        let word = ((COMMAND_BIT | reg) &lt;&lt; 8) | val;\" line33=\"        pins.i2cWriteNumber(TSL2591_ADDR, word, NumberFormat.UInt16BE, false);\" line34=\"    }\" line35=\"\" line36=\"    function readRegister16(reg: number): number {\" line37=\"        pins.i2cWriteNumber(TSL2591_ADDR, COMMAND_BIT | reg, NumberFormat.UInt8BE, true);\" line38=\"        return pins.i2cReadNumber(TSL2591_ADDR, NumberFormat.UInt16LE, false);\" line39=\"    }\" line40=\"\" line41=\"    // Auto-initializes sensor with default settings if not already run\" line42=\"    function autoInit(): void {\" line43=\"        if (!isInitialized) {\" line44=\"            init(Gain.Medium, IntegrationTime.ms100);\" line45=\"        }\" line46=\"    }\" line47=\"\" line48=\"    /**\" line49=\"     * Initialize the TSL2591 sensor manually with custom settings.\" line50=\"     */\" line51=\"    //% blockId=&quot;tsl2591_init&quot; block=&quot;initialize TSL2591 | gain %gain | integration time %time&quot;\" line52=\"    //% gain.defl=tsl2591.Gain.Medium\" line53=\"    //% time.defl=tsl2591.IntegrationTime.ms100\" line54=\"    //% weight=100\" line55=\"    export function init(gain: Gain = Gain.Medium, time: IntegrationTime = IntegrationTime.ms100): void {\" line56=\"        writeRegister(0x00, 0x03);\" line57=\"        writeRegister(0x01, gain | time);\" line58=\"        isInitialized = true;\" line59=\"    }\" line60=\"\" line61=\"    /**\" line62=\"     * Read total light intensity in Lux.\" line63=\"     */\" line64=\"    //% blockId=&quot;tsl2591_read_lux&quot; block=&quot;TSL2591 read lux&quot;\" line65=\"    //% weight=90\" line66=\"    export function readLux(): number {\" line67=\"        autoInit();\" line68=\"        let ch0 = readRegister16(0x14);\" line69=\"        let ch1 = readRegister16(0x16);\" line70=\"        let cpl = (100 * 25) / 408;\" line71=\"        let lux = (ch0 - 1.64 * ch1) / cpl;\" line72=\"        return Math.max(0, Math.round(lux));\" line73=\"    }\" line74=\"\" line75=\"    /**\" line76=\"     * Read estimated visible light level.\" line77=\"     */\" line78=\"    //% blockId=&quot;tsl2591_read_visible&quot; block=&quot;TSL2591 read visible light&quot;\" line79=\"    //% weight=80\" line80=\"    export function readVisible(): number {\" line81=\"        autoInit();\" line82=\"        let ch02 = readRegister16(0x14);\" line83=\"        let ch12 = readRegister16(0x16);\" line84=\"        return Math.max(0, ch02 - ch12);\" line85=\"    }\" line86=\"\" line87=\"    /**\" line88=\"     * Read raw Full Spectrum channel (CH0).\" line89=\"     */\" line90=\"    //% blockId=&quot;tsl2591_read_full&quot; block=&quot;TSL2591 read full spectrum (CH0)&quot;\" line91=\"    //% weight=70\" line92=\"    //% advanced=true\" line93=\"    export function readFullSpectrum(): number {\" line94=\"        autoInit();\" line95=\"        return readRegister16(0x14);\" line96=\"    }\" line97=\"\" line98=\"    /**\" line99=\"     * Read raw Infrared channel (CH1).\" line100=\"     */\" line101=\"    //% blockId=&quot;tsl2591_read_ir&quot; block=&quot;TSL2591 read infrared (CH1)&quot;\" line102=\"    //% weight=60\" line103=\"    //% advanced=true\" line104=\"    export function readInfrared(): number {\" line105=\"        autoInit();\" line106=\"        return readRegister16(0x16);\" line107=\"    }\" line108=\"}\" numlines=\"109\"></mutation></block></statement></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":3137,"length1":1,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":262,"length1":75,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1793720192492,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml